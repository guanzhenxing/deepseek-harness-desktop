{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  "references": [
    { "path": "apps/desktop-launcher" },
    { "path": "packages/desktop-contracts" },
    { "path": "packages/desktop-plugin" },
    { "path": "packages/host-supervisor" },
    { "path": "packages/profile-manager" },
    { "path": "packages/shell-core" }
  ]
}
