        "upstream:dd6322d604e00eec1ba5e0c8541159906a21094a"
      ],
      "$notes": "First line of session.jsonl / session.jsonl.zstd is a {type:'session',version:N} header; this baseline writes SESSION_FORMAT_VERSION=0 and refuses headers carrying retired policy fields. .zstd files are multi-frame."
    },
    {
      "provider": "@deepseek-ai/dsh-storage-json",
      "providerVersion": "0.1.2-alpha.3",
      "formatId": "dsh-storage-unit-0.1.2-alpha.3",
