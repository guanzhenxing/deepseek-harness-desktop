      "writable": "dsh-settings-file-0.1.2-alpha.3",
      "evidence": [
        "npm:@deepseek-ai/dsh-settings-file@0.1.2-alpha.3:lib/index.js",
        "fixture:tests/fixtures/home-formats/settings.yaml#db74b2ddfc5f2e203738be3ccac319a727369c716aa8b2374654dab5f2059be7",
        "upstream:dd6322d604e00eec1ba5e0c8541159906a21094a"
      ],
      "$notes": "<home>/settings.yaml (or .json) is a schemastery-validated document with NO upstream numeric schema version; the provider build itself is the format identity. No schema version is fabricated."
    },
    {
      "provider": "@deepseek-ai/dsh-session-persistence-jsonl",
      "providerVersion": "0.1.2-alpha.3",
      "formatId": "dsh-session-jsonl-0",
      "readable": ["dsh-session-jsonl-0"],
      "writable": "dsh-session-jsonl-0",
