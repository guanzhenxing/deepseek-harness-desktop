      "writable": "dsh-profile-manifest-0.1.2-alpha.3",
      "evidence": [
        "repo:packages/profile-manager/src/reconcile-templates.ts",
        "fixture:tests/fixtures/home-formats/profile-package.json#d193ec18a8a948d68b31cd4bc0217cf1659e198cbd591e8d8c0c177621710a9c",
        "upstream:dd6322d604e00eec1ba5e0c8541159906a21094a"
      ],
      "$notes": "A profile directory is a package.json manifest (dsh.profile.bundles) plus cordis.patch.yml plus pnpm-workspace.yaml. The manifest template is app-owned (profile-manager) and pinned to this baseline; the patch layer is the user's."
    }
  ]
}
